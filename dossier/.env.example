# Copy to .env (never commit .env). Used by the reasoning step and the simulated calls.
OPENROUTER_API_KEY=
REASON_MODEL=deepseek/deepseek-v4-pro
CALLEE_MODEL=deepseek/deepseek-v4.1-flash
# Speech for simulated calls (ElevenLabs over OpenRouter, Mira's voice): 1 renders every turn to data/out/audio; anything else renders nothing.
SIM_TTS=1
