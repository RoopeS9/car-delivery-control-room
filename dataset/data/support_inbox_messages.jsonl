{"author_id": "drv-434", "author_type": "driver", "authored_at": "2026-10-21T07:18:00Z", "body": "Where do I upload a parking receipt after a job?", "channel": "app_chat", "id": "inboxmsg-xab759151c3e7f6f5", "language": "en", "recipient_id": "ops-support", "recipient_type": "operator", "thread_id": "inbox-x55713f1bffbc16af", "visibility": "PUBLIC"}
