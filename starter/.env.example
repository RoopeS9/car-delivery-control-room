DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# Road Desk agent (team Random). Claude runs through OpenRouter; the agent
# answers with a canned reply and hands every case to a person without a key.
OPENROUTER_API_KEY=
AGENT_MODEL=deepseek/deepseek-v4-pro
SIM_DRIVER_MODEL=anthropic/claude-haiku-5.5
# Stronger, about 10x the cost: AGENT_MODEL=anthropic/claude-sonnet-5.5. The safety screen and the photo reader have their own models.
DRIVABILITY_MODEL=deepseek/deepseek-v4-flash
VISION_MODEL=anthropic/claude-haiku-5.5
AGENT_EFFORT_FAST=low
AGENT_EFFORT_DEEP=medium
# Simulated clock: our new events continue from the dataset snapshot.
SIM_NOW=2026-10-21T09:00:00Z
SIM_DRIVER_ENABLED=true
