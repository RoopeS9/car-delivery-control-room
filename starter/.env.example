DATABASE_URL=postgres://controlroom:controlroom@localhost:5438/controlroom
S3_ENDPOINT=http://127.0.0.1:9009
S3_ACCESS_KEY_ID=controlroom
S3_SECRET_ACCESS_KEY=controlroom-local-only
S3_BUCKET=controlroom-attachments

# Road Desk agent (team Random). Claude runs through OpenRouter; the agent
# answers with a canned reply and hands every case to a person without a key.
OPENROUTER_API_KEY=
AGENT_MODEL=anthropic/claude-sonnet-5.5
SIM_DRIVER_MODEL=anthropic/claude-haiku-5.5
AGENT_EFFORT_FAST=low
AGENT_EFFORT_DEEP=medium
# Simulated clock: our new events continue from the dataset snapshot.
SIM_NOW=2026-10-21T09:00:00Z
SIM_DRIVER_ENABLED=true

# Voice (driver call, PLAN.md 4.6). Needs OPENROUTER_API_KEY.
VOICE_INTERVIEW_MODEL=anthropic/claude-sonnet-5.5
VOICE_INTERVIEW_EFFORT=low
VOICE_SCREEN_MODEL=anthropic/claude-haiku-5.5
VOICE_STT_MODEL=openai/gpt-4o-transcribe
VOICE_LIVE_STT=browser
VOICE_TTS_MODEL=elevenlabs/eleven-flash-v2.5
VOICE_TTS_VOICE_AGENT=21m00Tcm4TlvDq8ikWAM
VOICE_TTS_VOICE_DRIVER=
# openrouter (default) or browser: browser speaks with speechSynthesis, no server speech or transcription
VOICE_PROVIDER=openrouter
# Where stream A's agent accepts call_urgent / call_ended
VOICE_AGENT_TRIGGER_PATH=/api/agent/call
# Interviewer model for npm run voice:test (defaults to VOICE_INTERVIEW_MODEL)
VOICE_TEST_MODEL=
